# LeadForge environment variables
# Copy to .env and fill in your values

# Required: NVIDIA NIM API key (free tier at https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-your-key-here

# Optional: Custom NIM endpoint (default: https://integrate.api.nvidia.com/v1)
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: Custom model (default: nvidia/nemotron-3-ultra-550b-a55b)
# NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Optional: Brevo API key for ColdEmailOS integration
# BREVO_API_KEY=xkeysib-...

# Optional: Jev API key for semantic gating (optional)
# JEV_API_KEY=...